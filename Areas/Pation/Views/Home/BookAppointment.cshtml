<h1>Book Appointment</h1>

<div class="container">
    <div class="row d-flex flex-wrap">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4 d-flex">
                <div class="card w-100">
                    <img class="card-img-top" src="~/image/@item.Img" style="width: 100%; height: 100%; object-fit: cover;" alt="Doctor Image">
                    <div class="card-body text-center">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">Specialization: @item.Specialization</p>
                        <a href="/Pation/Home/CompleteAppointment?DocId=@item.Id" class="btn btn-primary">Book Appointment</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
