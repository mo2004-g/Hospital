@model Profile
<!DOCTYPE html>
<html lang="ar" >
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تعديل الملف الشخصي</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f7f9fc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .profile-form {
            background: #fff;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.05);
        }

        .form-control:focus {
            box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
        }

        label {
            font-weight: 500;
        }

        .form-title {
            font-weight: bold;
            font-size: 1.6rem;
            margin-bottom: 20px;
        }

        .submit-btn {
            background-color: #007bff;
            border: none;
            padding: 12px 25px;
            font-size: 1rem;
            border-radius: 50px;
            transition: background-color 0.3s;
        }

            .submit-btn:hover {
                background-color: #0056b3;
            }
    </style>
</head>
<body>

    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="profile-form">
                    <div class="text-center mb-4">
                        <h2 class="form-title">Edit Profile  </h2>
                    </div>

                    <form method="post" enctype="multipart/form-data">

                        <div class="mb-3">
                            <label for="Name" class="form-label">Name</label>
                            <input type="text" class="form-control" id="Name" name="Name" required minlength="3" maxlength="50" value="@User.Identity.Name" />
                           
                        </div>

                        <div class="mb-3">
                            <label for="Email" class="form-label"> Email</label>
                            <input type="email" class="form-control" id="Email" name="Email" required value="@Model.Email" />
                            
                        </div>

                        <div class="mb-3">
                            <label for="PhoneNumber" class="form-label">Phone </label>
                            <input type="tel" class="form-control" id="PhoneNumber" name="PhoneNumber" required  value="@Model.PhoneNumber"/>
                        </div>

                        <div class="mb-3">
                            <label for="Address" class="form-label">Address</label>
                            <input type="text" class="form-control" id="Address" name="Address" value="@Model.Address"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Chronic diseases</label>
                            <div id="diseases-list">
                                <div class="disease-item input-group mb-2">
                                    <input type="text" name="Diseases" class="form-control" placeholder="اكتب اسم المرض" />
                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeDisease(this)">✖</button>
                                </div>
                            </div>

                            <button type="button" class="btn btn-outline-secondary btn-sm mt-2" onclick="addDisease()">➕ إضافة مرض آخر</button>
                        </div>

                        <div class="mb-4">
                            <label for="file" class="form-label" > Image</label>
                            <input type="file" class="form-control" id="file" name="file" />
                        </div>

                        <div class="text-center">
                            <button type="submit" class="submit-btn text-white">💾 Save </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>

</body>
</html>

@section Scripts {
    <script>
            function addDisease() {
            const container = document.getElementById("diseases-list");

            const div = document.createElement("div");
            div.className = "disease-item input-group mb-2";

            const input = document.createElement("input");
            input.type = "text";
            input.name = "Diseases";
            input.className = "form-control";
            input.placeholder = "اكتب اسم المرض";

            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "btn btn-outline-danger btn-sm";
            btn.innerText = "✖";
            btn.onclick = function () {
                removeDisease(btn);
            };

            div.appendChild(input);
            div.appendChild(btn);

            container.appendChild(div);
        }

        function removeDisease(button) {
            button.parentElement.remove();
        }
    </script>
}