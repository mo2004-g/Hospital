@model Doctor

<div class="container my-3">
    <div class="row">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h1>Create Doctor</h1>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <form asp-action="Create" asp-controller="Doctor" asp-area="Admin" enctype="multipart/form-data" >
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Doctor Name</label>
                    <input type="text" class="form-control" asp-for="Name" >
                    <span class="text-danger" asp-validation-for="Name"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Specialization" class="form-label">Specialization </label>
                    <input type="text" class="form-control" asp-for="Specialization">
                    <span class="text-danger" asp-validation-for="Specialization"></span>
                </div>
                <div class="mb-3">
                    <label id="file" class="form-label">Photo</label>
                    <input type="file" class="form-control" name="file" >
                    
                </div>


                <button type="submit" class="btn btn-primary">Save</button>
            </form>
        </div>
    </div>
</div>

                    @section scripts
                    {
    <partial name="_ValidationScriptsPartial.cshtml">
        
        <script>
            toastr.Success('@TempData["notification"]');
        </script>


    }